// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "minimum_contrast_for_highlights": 60,

  "colorize_brackets": false,

  "git_panel": {
    "collapse_untracked_diff": true,
    "tree_view": true,
  },
  "project_panel": {
    "hide_hidden": false,
    "diagnostic_badges": false,
    "show_diagnostics": "all",
    "hide_gitignore": true,
  },
  "tabs": {
    "git_status": true,
    "show_diagnostics": "all",
  },
  "icon_theme": "Zed (Default)",
  "debugger": {
    "save_breakpoints": true,
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 500,
    },
  },

  "buffer_font_features": {
    "calt": false,
  },

  "ui_font_size": 15,
  "buffer_font_size": 16,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Rafa Dark",
  },
  "toolbar": {
    "breadcrumbs": false,
  },
  "cursor_shape": "block",
  "cursor_blink": true,

  "git": {
    "hunk_style": "staged_hollow",
    "inline_blame": {
      "show_commit_summary": true,
      "enabled": false,
    },

    "git_gutter": "tracked_files",
    "enable_status": true,
    "enable_diff": true,
  },

  "diff_view_style": "split",

  "gutter": {
    "folds": false,
    "line_numbers": true,
  },
  "indent_guides": {
    "enabled": false,
  },

  "show_wrap_guides": true,
  "wrap_guides": [80],

  "diagnostics": {
    "inline": {
      "enabled": false,
    },
  },

  "max_tabs": 4,

  "languages": {
    "C++": {
      "inlay_hints": {
        "edit_debounce_ms": 500,
        "enabled": false,
      },
      "completions": {
        "words_min_length": 1,
      },
      "show_wrap_guides": true,
      "tab_size": 2,
      "formatter": {
        "external": {
          "command": "clang-format-20",
          "arguments": ["--style=file", "--assume-filename={buffer_path}"],
        },
      },
      "format_on_save": "on",
    },
    "Markdown": {},
  },
  "completions": {
    "lsp": true,
  },

  "lsp": {
    "clangd": {
      "binary": {
        "arguments": [
          "--clang-tidy=false",
          "--background-index=false",
          "--header-insertion=never",
        ],
      },
    },
  },

  "show_completions_on_input": true,
  "show_completion_documentation": true,
  "hover_popover_enabled": true,
  "lsp_document_colors": "inlay",

  "scrollbar": {
    "git_diff": true,
    "axes": {
      "horizontal": false,
      "vertical": false,
    },
  },

  "minimap": {
    "display_in": "all_editors",
    "show": "always",
    "thumb": "always",
  },

  "current_line_highlight": "all",
}
