{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Rafa Claude Bar",
  "author": "Rafael Ferraz",
  "themes": [
    {
      "name": "Rafa Claude Bar",
      "appearance": "dark",
      "style": {
        "background.appearance": "opaque",
        "accents": [
          "#F0D080", "#FF6B80", "#63A1A3",
          "#F0D080", "#FF6B80", "#63A1A3",
          "#F0D080", "#FF6B80", "#63A1A3"
        ],
        "border": "#303030",
        "border.variant": "#505050",
        "border.focused": "#63A1A3",
        "border.selected": "#303030",
        "border.transparent": "#303030",
        "border.disabled": "#303030",
        "elevated_surface.background": "#1E1E1E",
        "surface.background": "#5F5F5F66",
        "background": "#0A0A0A",
        "element.background": "#63A1A3",
        "element.hover": "#303030",
        "element.active": "#303030",
        "element.selected": "#303030",
        "ghost_element.hover": "#FFFFFF06",
        "ghost_element.active": "#FFFFFF0C",
        "ghost_element.selected": "#303030",
        "text": "#CCCCCC",
        "text.muted": "#888888",
        "text.placeholder": "#7F7F7F",
        "text.disabled": "#5F5F5F",
        "status_bar.background": "#0A0A0A",
        "title_bar.background": "#0A0A0A",
        "title_bar.inactive_background": "#0A0A0A",
        "toolbar.background": "#0A0A0A",
        "tab_bar.background": "#0A0A0A",
        "tab.inactive_background": "#0A0A0A",
        "tab.active_background": "#1E1E1E",
        "search.match_background": "#FABD2E40",
        "panel.background": "#0A0A0A",
        "panel.focused_border": "#63A1A3",
        "panel.indent_guide": "#50505066",
        "panel.indent_guide_active": "#5F5F5F",
        "pane_group.border": "#FFFFFF17",
        "scrollbar.thumb.background": "#5F5F5F66",
        "scrollbar.thumb.hover_background": "#888888B3",
        "scrollbar.thumb.active_background": "#99999966",
        "scrollbar.track.border": "#0A0A0A",
        "minimap.thumb.background": "#5F5F5F33",
        "minimap.thumb.hover_background": "#7F7F7F59",
        "minimap.thumb.active_background": "#88888833",
        "editor.foreground": "#CCCCCC",
        "editor.background": "#0A0A0A",
        "editor.gutter.background": "#0A0A0A",
        "editor.active_line.background": "#1a1a1a",
        "editor.line_number": "#5F5F5F",
        "editor.active_line_number": "#CCCCCC",
        "editor.wrap_guide": "#303030",
        "editor.active_wrap_guide": "#303030",
        "editor.indent_guide": "#303030",
        "editor.indent_guide_active": "#505050",
        "editor.document_highlight.read_background": "#63A1A326",
        "editor.document_highlight.write_background": "#63A1A340",
        "editor.document_highlight.bracket_background": "#63A1A326",
        "terminal.background": "#0A0A0A",
        "terminal.foreground": "#CCCCCC",
        "terminal.ansi.black": "#000000",
        "terminal.ansi.bright_black": "#5F5F5F",
        "terminal.ansi.red": "#FF6B80",
        "terminal.ansi.bright_red": "#FF6B80",
        "terminal.ansi.green": "#8DC07C",
        "terminal.ansi.bright_green": "#8DC07C",
        "terminal.ansi.yellow": "#F0D080",
        "terminal.ansi.bright_yellow": "#F0D080",
        "terminal.ansi.blue": "#63A1A3",
        "terminal.ansi.bright_blue": "#63A1A3",
        "terminal.ansi.magenta": "#FF6B80",
        "terminal.ansi.bright_magenta": "#FF6B80",
        "terminal.ansi.cyan": "#63A1A3",
        "terminal.ansi.bright_cyan": "#63A1A3",
        "terminal.ansi.white": "#CCCCCC",
        "terminal.ansi.bright_white": "#CCCCCC",
        "link_text.hover": "#63A1A3",
        "version_control.added": "#8DC07C",
        "version_control.deleted": "#FF6B80",
        "version_control.modified": "#F0D080",
        "version_control.renamed": "#63A1A3",
        "version_control.conflict": "#FF6B80",
        "version_control.ignored": "#5F5F5F",
        "version_control.conflict_marker.ours": "#8DC07C80",
        "version_control.conflict_marker.theirs": "#63A1A380",
        "created": "#8DC07C",
        "modified": "#F0D080",
        "deleted": "#FF6B80",
        "renamed": "#63A1A3",
        "conflict": "#FF6B80",
        "ignored": "#5F5F5F",
        "hidden": "#888888",
        "error": "#FF6B80",
        "error.background": "#1E1E1E",
        "error.border": "#505050",
        "warning": "#F0D080",
        "warning.background": "#1E1E1E",
        "warning.border": "#505050",
        "hint": "#88888859",
        "hint.background": "#1E1E1E",
        "hint.border": "#505050",
        "info": "#63A1A3",
        "info.background": "#1E1E1E",
        "info.border": "#505050",
        "players": [
          { "cursor": "#CCCCCC", "background": null, "selection": "#63A1A340" },
          { "cursor": "#63A1A3", "background": "#63A1A3", "selection": "#63A1A33D" },
          { "cursor": "#F0D080", "background": "#F0D080", "selection": "#FABD2E3D" },
          { "cursor": "#FF6B80", "background": "#FF6B80", "selection": "#FF6B803D" },
          { "cursor": "#8DC07C", "background": "#8DC07C", "selection": "#8DC07C3D" },
          { "cursor": "#938274", "background": "#938274", "selection": "#9382743D" },
          { "cursor": "#999999", "background": "#999999", "selection": "#9999993D" },
          { "cursor": "#888888", "background": "#888888", "selection": "#8888883D" }
        ],
        "syntax": {
          "attribute":               { "color": "#63A1A3" },
          "boolean":                 { "color": "#F0D080" },
          "comment":                 { "color": "#5F5F5F" },
          "comment.doc":             { "color": "#6F6F6F" },
          "constant":                { "color": "#63A1A3" },
          "constructor":             { "color": "#F0D080" },
          "embedded":                { "color": "#CCCCCC" },
          "emphasis.strong":         { "color": "#F0D080", "font_weight": 700 },
          "function":                { "color": "#8DC07C" },
          "keyword":                 { "color": "#FF6B80" },
          "keyword.declaration":     { "color": "#FF6B80" },
          "keyword.control":         { "color": "#FF6B80" },
          "keyword.import":          { "color": "#FF6B80" },
          "number":                  { "color": "#F0D080" },
          "operator":                { "color": "#CCCCCC" },
          "preproc":                 { "color": "#FF6B80" },
          "property":                { "color": "#63A1A3" },
          "punctuation":             { "color": "#888888" },
          "punctuation.bracket":     { "color": "#888888" },
          "punctuation.delimiter":   { "color": "#888888" },
          "punctuation.list_marker": { "color": "#888888" },
          "punctuation.special":     { "color": "#FF6B80" },
          "string":                  { "color": "#938274" },
          "string.escape":           { "color": "#F0D080" },
          "string.regex":            { "color": "#FF6B80" },
          "string.special":          { "color": "#FF6B80" },
          "string.special.symbol":   { "color": "#FF6B80" },
          "tag":                     { "color": "#FF6B80" },
          "text.literal":            { "color": "#938274" },
          "type":                    { "color": "#63A1A3" },
          "variable":                { "color": "#CCCCCC" },
          "variable.special":        { "color": "#F0D080" }
        }
      }
    }
  ]
}
