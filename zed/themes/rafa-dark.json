          { "cursor": "#95E5CBFF", "background": "#95E5CBFF", "selection": "#95E5CB3D" },
          { "cursor": "#EF7177FF", "background": "#EF7177FF", "selection": "#EF71773D" },
          { "cursor": "#FEB454FF", "background": "#FEB454FF", "selection": "#FEB4543D" },
          { "cursor": "#AAD84CFF", "background": "#AAD84CFF", "selection": "#AAD84C3D" }
