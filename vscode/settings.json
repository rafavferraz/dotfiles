{
    "json.schemas": [],
    "workbench.navigationControl.enabled": false,
    "window.commandCenter": false,
    "claudeCode.preferredLocation": "panel",
    "editor.stickyScroll.enabled": false,
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.rulers": [80],
    "editor.guides.indentation": false,
    "C_Cpp.errorSquiggles": "enabled",
    "[cpp]": {
        "editor.wordBasedSuggestions": "off",
        "editor.semanticHighlighting.enabled": true,
        "editor.stickyScroll.defaultModel": "foldingProviderModel",
        "editor.suggest.insertMode": "replace"
    },
    "workbench.colorCustomizations": {
        "[Default Dark Modern]": {
            "editor.background": "#0A0A0A",
            "editor.foreground": "#CCCCCC",
            "editor.lineHighlightBackground": "#1A1A1A",
            "editor.selectionBackground": "#264F78",
            "editor.findMatchHighlightBackground": "#C6510666",
            "editorLineNumber.foreground": "#6E7681",
            "editorLineNumber.activeForeground": "#CCCCCC",
            "editorRuler.foreground": "#2B2B2B",
            "editorError.foreground": "#F14C4C",
            "editorWarning.foreground": "#CCA700",
            "editorGutter.addedBackground": "#8DC07C",
            "editorGutter.modifiedBackground": "#F0D080",
            "editorGutter.deletedBackground": "#FF6B80",
            "sideBar.background": "#0A0A0A",
            "sideBar.border": "#2B2B2B",
            "activityBar.background": "#0A0A0A",
            "statusBar.background": "#0A0A0A",
            "statusBar.noFolderBackground": "#0A0A0A",
            "statusBar.border": "#2B2B2B",
            "titleBar.activeBackground": "#0A0A0A",
            "titleBar.inactiveBackground": "#0A0A0A",
            "titleBar.border": "#2B2B2B",
            "panel.background": "#0A0A0A",
            "panel.border": "#2B2B2B",
            "terminal.background": "#0A0A0A",
            "terminal.foreground": "#CCCCCC",
            "editorGroupHeader.tabsBackground": "#0A0A0A",
            "editorGroup.border": "#FFFFFF17",
            "tab.inactiveBackground": "#0A0A0A",
            "tab.activeBackground": "#2A2D2E",
            "list.hoverBackground": "#2A2D2E",
            "list.activeSelectionBackground": "#2A2D2E",
            "list.inactiveSelectionBackground": "#2A2D2E",
            "focusBorder": "#0078D4",
            "scrollbarSlider.background": "#79797966",
            "scrollbarSlider.hoverBackground": "#646464B3",
            "scrollbarSlider.activeBackground": "#BFBFBF66",
            "minimapSlider.background": "#79797933",
            "minimapSlider.hoverBackground": "#64646459",
            "minimapSlider.activeBackground": "#BFBFBF33",
            "gitDecoration.addedResourceForeground": "#8DC07C",
            "gitDecoration.untrackedResourceForeground": "#8DC07C",
            "gitDecoration.modifiedResourceForeground": "#F0D080",
            "gitDecoration.deletedResourceForeground": "#FF6B80",
            "gitDecoration.renamedResourceForeground": "#73C991",
            "gitDecoration.conflictingResourceForeground": "#E4676B",
            "gitDecoration.ignoredResourceForeground": "#8C8C8C"
        }
    },
    "files.autoSave": "afterDelay",
    "files.exclude": {
        "**/.*": true
    },
    "workbench.activityBar.location": "hidden",
    "C_Cpp.default.cppStandard": "gnu++20",
    "makefile.configureOnOpen": true,
    "workbench.secondarySideBar.defaultVisibility": "hidden",
    "python.analysis.typeCheckingMode": "basic",
    "json.format.enable": false,
    "breadcrumbs.enabled": false
}